# URL da entregador-api vista pelo navegador. Padrão: /api (proxy do Vite em desenvolvimento ou proxy reverso).
VITE_API_URL=/api
# Destino do proxy /api no `npm run dev`.
API_PROXY_DESTINO=http://localhost:3000
# Servidor de mapas (padrão: OpenStreetMap público, com política de uso justo). A atribuição é obrigatória.
VITE_MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
